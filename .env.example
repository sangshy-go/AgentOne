# ============================================================
# AgentOne Docker 部署环境变量示例
# 复制为 .env 后按需修改：cp .env.example .env
# 全部可选项均有默认值，不创建 .env 也可直接 docker compose up。
# ============================================================

# ---- 端口（默认值如下，本机端口冲突时覆盖）----
# WEB_PORT=80
# API_PORT=8080
# POSTGRES_PORT=5432
# REDIS_PORT=6379

# ---- 数据库 / Redis 凭据 ----
# POSTGRES_DB=agentone
# POSTGRES_USER=agentone
# POSTGRES_PASSWORD=agentone123
# REDIS_PASSWORD=agentone123

# ---- 全局默认模型（可选）----
# OPENAI_API_KEY=sk-xxx
# OPENAI_BASE_URL=https://api.openai.com
# AGENT_MODEL=gpt-4o-mini

# ---- 安全（生产环境务必修改）----
# JWT_SECRET=change-me-to-a-random-long-string
